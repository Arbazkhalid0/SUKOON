
<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#103c32">

  <title>SUKOON | اسلامی طرزِ زندگی</title>

  <meta name="description" content="SUKOON - ایک خوبصورت اسلامی لائف اسٹائل اور روحانی رہنمائی کی ایپ">

  <link rel="stylesheet" href="css/style.css">
</head>

<body>

  <!-- Header -->
  <header class="header">
    <a href="#" class="brand">
      <span class="brand-icon">☾</span>
      <span>SUKOON</span>
    </a>

    <button class="profile-btn" aria-label="پروفائل">
      ♙
    </button>
  </header>

  <main>

    <!-- Welcome Section -->
    <section class="welcome">
      <p class="welcome-label">السلام علیکم!</p>
      <h1>آپ کا دن بابرکت ہو</h1>
      <p class="welcome-text">
        اپنے دل کو اللہ کے ذکر سے روشن رکھیں۔
      </p>
    </section>

    <!-- Daily Inspiration -->
    <section class="daily-card">
      <span class="section-tag">آج کی یاد دہانی</span>
      <div class="daily-symbol">✧</div>
      <h2>دلوں کا سکون اللہ کے ذکر میں ہے</h2>
      <p>اپنے ہر دن کا آغاز اچھی نیت اور اللہ کی یاد سے کریں۔</p>
    </section>

    <!-- Main Features -->
    <section class="features-section" id="features">
      <div class="section-heading">
        <div>
          <p class="small-label">YOUR SPIRITUAL JOURNEY</p>
          <h2>آپ کی عبادات اور رہنمائی</h2>
        </div>
      </div>

      <div class="features-grid">

        <a href="pages/prayer.html" class="feature-card">
          <span class="feature-icon">☪</span>
          <h3>نماز</h3>
          <p>نماز اور عبادات</p>
        </a>

        <a href="pages/quran.html" class="feature-card">
          <span class="feature-icon">۞</span>
          <h3>قرآن پاک</h3>
          <p>تلاوت اور مطالعہ</p>
        </a>

        <a href="pages/azkar.html" class="feature-card">
          <span class="feature-icon">❀</span>
          <h3>اذکار</h3>
          <p>صبح و شام کے اذکار</p>
        </a>

        <a href="pages/duas.html" class="feature-card">
          <span class="feature-icon">🤲</span>
          <h3>دعائیں</h3>
          <p>روزمرہ کی مسنون دعائیں</p>
        </a>

        <a href="pages/islamic-calendar.html" class="feature-card">
          <span class="feature-icon">☾</span>
          <h3>اسلامی کیلنڈر</h3>
          <p>ہجری تاریخ اور ایام</p>
        </a>

        <a href="pages/seerah.html" class="feature-card">
          <span class="feature-icon">♡</span>
          <h3>سیرت النبی ﷺ</h3>
          <p>حیاتِ رسول ﷺ</p>
        </a>

        <a href="pages/islamic-history.html" class="feature-card">
          <span class="feature-icon">⌛</span>
          <h3>اسلامی تاریخ</h3>
          <p>تاریخی واقعات</p>
        </a>

        <a href="pages/quiz.html" class="feature-card">
          <span class="feature-icon">✧</span>
          <h3>اسلامی کوئز</h3>
          <p>اپنا علم آزمائیں</p>
        </a>

      </div>
    </section>

    <!-- Daily Challenge -->
    <section class="challenge-card">
      <span>روزانہ کا روحانی چیلنج</span>
      <h2>آج کسی ایک شخص کے لیے دعا کریں۔</h2>
      <p>چھوٹی نیکیاں بھی بڑی اہمیت رکھتی ہیں۔</p>
      <button type="button" class="challenge-btn">
        ان شاء اللہ، مکمل کروں گا
      </button>
    </section>

  </main>

  <!-- Bottom Navigation -->
  <nav class="bottom-nav">
    <a href="#" class="nav-item active">
      <span>⌂</span>
      <small>ہوم</small>
    </a>

    <a href="#features" class="nav-item">
      <span>☪</span>
      <small>عبادات</small>
    </a>

    <a href="pages/duas.html" class="nav-item">
      <span>🤲</span>
      <small>دعائیں</small>
    </a>

    <a href="pages/settings.html" class="nav-item">
      <span>⚙</span>
      <small>سیٹنگز</small>
    </a>
  </nav>

</body>
</html>
